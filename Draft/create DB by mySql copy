CREATE DATABASE MYDATABASE;

use MYDATABASE

CREATE TABLE users (
    id CHAR(36) PRIMARY KEY DEFAULT (UUID()),
    username VARCHAR(50) UNIQUE,
    password VARCHAR(255),
    fullName VARCHAR(100),
    phone VARCHAR(20),
    address VARCHAR(255),
    email VARCHAR(100),
    avatar VARCHAR(255)
);


